# Spring Boot backend API URL.
# Use localhost when the frontend and backend run on the same computer.
# To access the application from other devices on the local network,
# replace localhost with your computer's local IP address
# (for example, http://192.168.0.100:8080).

NEXT_PUBLIC_API_URL=http://localhost:8080

# Cloudflare Turnstile (CAPTCHA) site key of the widget shown in the registration and found pigeon forms.
# The value below is Cloudflare's official test key that always passes, so local development works
# without a Cloudflare account. Use it together with the test secret key from backend/.env.example.
# Replace it with the site key of your own widget in production.

NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA