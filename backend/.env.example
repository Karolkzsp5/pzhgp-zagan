# JWT
JWT_SECRET=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/db_name
DB_USERNAME=REPLACE_WITH_YOUR_POSTGRESQL_USERNAME
DB_PASSWORD=REPLACE_WITH_YOUR_POSTGRESQL_PASSWORD

# Allowed frontend origins for Cross-Origin Resource Sharing (CORS).
# Separate multiple origins with commas.
# Add your local network IP address when accessing the frontend from other devices.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Secure flag of the authentication cookie.
# Set to true in production, where the application is served over HTTPS.
# Keep false for local development over HTTP, otherwise the browser will not store the login cookie.
AUTH_COOKIE_SECURE=false

# Set to native when the backend runs behind a reverse proxy (e.g. nginx) that sends X-Forwarded-For.
# Leave none when clients connect directly, otherwise they could fake their address in that header.
FORWARD_HEADERS_STRATEGY=none

# Cloudflare Turnstile (CAPTCHA) secret key used to verify the tokens sent by the registration
# and found pigeon forms. The value below is Cloudflare's official test key that accepts every token,
# so local development works without a Cloudflare account.
# Replace it with the secret key of your own widget in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# SMTP server used to send e-mails with the password reset link.
# The values below match a local test server such as Mailpit, which needs no username or password.
# For a real mailbox set the host, port (usually 587), username and password of its SMTP server,
# for example smtp.gmail.com with an app password.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# Sender address of the e-mails. Most SMTP servers require it to match the mailbox used above.
MAIL_FROM=no-reply@pzhgp-zagan.local

# Frontend address placed in the links sent by e-mail.
FRONTEND_URL=http://localhost:3000