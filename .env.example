# Settings for docker compose. Copy this file to .env in the project root (next to docker-compose.yml).

# Password of the PostgreSQL database running in the container.
DB_PASSWORD=REPLACE_WITH_A_DATABASE_PASSWORD

# Random secret used to sign login tokens (at least 32 characters).
JWT_SECRET=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET

# Cloudflare Turnstile (CAPTCHA) keys. The values below are Cloudflare's official test keys
# that always pass, so the application works without a Cloudflare account.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
